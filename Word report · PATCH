@@ -795,6 +797,37 @@
         updateValidation();
       }
 
+      async function downloadDocx(group) {
+        const selected = currentReports.find((report) => report.id === $("savedReports").value);
+        if (!selected) return showToast("Banza uhitemo raporo wabitswe mu rutonde.", true);
+        const key = (report) => [report.fields.visitType, report.fields.visitDate, report.fields.cell].join("|");
+        const chosen = group
+          ? currentReports.filter((report) => key(report) === key(selected))
+          : [selected];
+        chosen.sort((a, b) => String(a.fields.reportNumber).localeCompare(String(b.fields.reportNumber)));
+        try {
+          const response = await fetch("/api/reports/docx", {
+            method: "POST",
+            headers: { "Content-Type": "application/json", Authorization: "Bearer " + authToken },
+            body: JSON.stringify({ ids: chosen.map((report) => report.id) })
+          });
+          if (!response.ok) {
+            const body = await response.json().catch(() => ({}));
+            throw new Error(body.error || "Ntibishobotse gukora Word.");
+          }
+          const blob = await response.blob();
+          const match = /filename="([^"]+)"/.exec(response.headers.get("Content-Disposition") || "");
+          const link = document.createElement("a");
+          link.href = URL.createObjectURL(blob);
+          link.download = match ? match[1] : "Raporo_Imihigo.docx";
+          link.click();
+          URL.revokeObjectURL(link.href);
+          showToast("Word yakozwe (" + chosen.length + (chosen.length > 1 ? " raporo)." : " raporo)."));
+        } catch (error) {
+          showToast(error.message, true);
+        }
+      }
+
       function exportJson() {
         const report = collectReport();
         const blob = new Blob([JSON.stringify(report, null, 2)], { type: "application/json;charset=utf-8" });
